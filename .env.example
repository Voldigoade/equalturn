# Local development only. Replace this value before starting PostgreSQL.
POSTGRES_PASSWORD=replace-with-a-local-random-password

# If the password contains URL-reserved characters, percent-encode it in these URLs.
EQUALTURN_DATABASE_URL=postgres://equalturn:replace-with-a-local-random-password@127.0.0.1:5432/equalturn
TEST_DATABASE_URL=postgres://equalturn:replace-with-a-local-random-password@127.0.0.1:5432/equalturn
