{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:equalturn:registry:schema:v3",
  "title": "Equalturn AI ecosystem research registry v3",
  "description": "A provenance-backed research dataset. Indicator classifications describe evidence quality and potential relevance; they are not enforcement rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "last_updated", "purpose", "entries"],
  "properties": {
    "schema_version": { "const": 3 },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "last_updated": { "type": "string", "format": "date" },
    "purpose": { "const": "research_only" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^source-[1-9][0-9]*$",
      "maxLength": 32
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "checked_on", "indicator_assessment"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
        "checked_on": { "type": "string", "format": "date" },
        "indicator_assessment": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "value", "platforms", "surfaces", "scope", "source_id", "verified_on",
        "confidence", "actionability", "false_positive_risk", "lifecycle", "limitations"
      ],
      "properties": {
        "kind": {
          "enum": [
            "web_hostname", "api_hostname", "url_path", "executable_name", "package_name",
            "windows_package_identity", "macos_bundle_id", "linux_desktop_id", "vscode_extension_id",
            "jetbrains_plugin_id", "browser_extension_id", "local_port", "service_name",
            "container_image", "protocol_endpoint"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Canonical value for this kind: lowercase hostname; HTTPS origin plus path for url_path; decimal port for local_port; kind-specific identifier otherwise."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Only platforms supported by evidence. Use unknown instead of inferring cross-platform availability.",
          "items": { "enum": ["windows", "linux", "macos", "android", "ios", "freebsd", "other", "unknown"] }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "description": "Indicator-specific user-facing or runtime surface, not every surface the product offers.",
          "items": {
            "enum": [
              "web", "api", "desktop", "ide", "browser_extension", "cli", "local_runtime", "server",
              "local_web_ui", "cloud", "mobile", "browser", "local_server", "python_library", "unknown"
            ]
          }
        },
        "scope": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "source_id": { "$ref": "#/$defs/sourceId" },
        "verified_on": { "type": "string", "format": "date" },
        "confidence": {
          "enum": ["high", "medium", "low"],
          "description": "Evidence confidence, not a probability that a participant used AI. See registry documentation for criteria."
        },
        "actionability": {
          "enum": ["research_only", "advisory", "detection_candidate", "blocking_candidate", "unsafe_to_block"],
          "description": "A research classification for future review, not an instruction to enforce."
        },
        "false_positive_risk": {
          "enum": ["low", "medium", "high", "unknown"],
          "description": "Risk that unrelated or permitted activity matches; unknown is not low."
        },
        "lifecycle": {
          "enum": ["current", "deprecated", "archived", "disputed", "unknown"],
          "description": "Indicator lifecycle, independent of the product record status."
        },
        "limitations": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "ecosystem": {
          "enum": ["cargo", "go", "npm", "nuget", "pypi", "rubygems", "unknown"]
        },
        "bind_scope": { "enum": ["loopback", "specific_interface", "any_interface", "unknown"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "package_name" } }, "required": ["kind"] },
          "then": { "required": ["ecosystem"] }
        },
        {
          "if": { "properties": { "kind": { "const": "local_port" } }, "required": ["kind"] },
          "then": { "required": ["bind_scope"], "properties": { "value": { "pattern": "^[0-9]{1,5}$" } } }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_id", "notes"],
      "properties": {
        "kind": { "enum": ["routes_to", "provided_by", "integrates_with"] },
        "target_id": { "$ref": "#/$defs/identifier" },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "product", "categories", "surfaces", "status", "sources", "indicators", "relationships"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "aliases": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
          }
        },
        "product": { "type": "string", "minLength": 1, "maxLength": 300 },
        "categories": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "enum": ["hosted_chat", "provider_api", "gateway", "coding_assistant", "ide_assistant", "browser_extension", "desktop_app", "cli_agent", "security_tool", "local_runner", "inference_server", "local_web_ui", "self_hosted_stack", "cloud_marketplace", "multimodal", "search_research", "regional_provider", "router"] }
        },
        "surfaces": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "enum": ["web", "api", "desktop", "ide", "browser_extension", "cli", "local_runtime", "server", "local_web_ui", "cloud", "mobile", "browser", "local_server", "python_library"] }
        },
        "status": { "enum": ["observed", "unknown", "deprecated", "archived", "disputed"] },
        "sources": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/source" } },
        "indicators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/indicator" } },
        "relationships": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/relationship" } }
      }
    }
  }
}
